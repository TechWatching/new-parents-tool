# Optional – leave blank to run in local-only mode with no cloud sync.
# Only the publishable (anon) key is used here; it is safe to commit as a
# placeholder.  NEVER put a service-role key in this file or in client code.
# Google/Microsoft OAuth client secrets belong in the backend provider settings,
# never in VITE_* variables. A new project URL is a different backend identity.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

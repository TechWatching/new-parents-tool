# Auto-detect text files and normalize line endings
* text=auto

# Source code
*.md text
*.json text
*.yaml text
*.yml text
*.toml text
*.vue text

# Force LF for shell scripts
*.sh text eol=lf
*.bash text eol=lf

# Force CRLF for Windows-specific files
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.zip binary
*.woff binary
*.woff2 binary
*.ttf binary

# Linguist overrides
*.min.js linguist-generated
*.min.css linguist-generated
pnpm-lock.yaml linguist-generated
